<configuration>
    <appender name="ELASTIC" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app_name": "booking-app"}</customFields>
        </encoder>
    </appender>

    <appender name="HTTP" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:9200</destination>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="ELASTIC" />
        <appender-ref ref="HTTP" />
    </root>
</configuration>
